---
/**
 * Veleiro (sloop) visto de lado, desenhado no VectorCraft (design/barco-veleiro.vectorcraft).
 * Paleta chapada do site, como o farol: vermelho, creme e a luz, com uma sombra só.
 * Balança na marola; a luz do mastro e as escotilhas acendem mais no barco em destaque
 * e no hover. Cada instância gera um id próprio para o degradê do reflexo.
 */
interface Props {
  /** Barco "no feixe": luzes mais fortes. */
  lit?: boolean;
}
const { lit = false } = Astro.props;
const reflection = `barco-reflexo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['boat', { 'boat--lit': lit }]} viewBox="16 2 198 142" aria-hidden="true">
  <defs>
    <linearGradient id={reflection} x1="0" y1="130" x2="0" y2="140.5" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ffe3a1" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#ffe3a1" stop-opacity="0"></stop>
    </linearGradient>
  </defs>

  <path class="boat__reflection" d="M50 130C90 136 160 136 196 130C170 144 80 144 50 130Z" fill={`url(#${reflection})`}></path>
  <g class="boat__hull">
    <g fill="none" stroke="#efe6d2" stroke-width="0.8" opacity="0.35">
      <path d="M120 14L203 104M119 15L26 99"></path>
      <path d="M30 94C70 102.5 150 104 201 99.5M50 98.4V104M74 100.8V106.4M176 101.9V107.6M196 100V105.5"></path>
    </g>
    <path d="M116 24C100 52 70 82 34 99L112 104C114 72 115.5 46 116 24Z" fill="#efe6d2" opacity="0.7"></path>
    <path d="M122 18V91L186 92C176 66 152 40 122 18Z" fill="#efe6d2"></path>
    <rect x="119.5" y="12" width="2.6" height="96" fill="#efe6d2"></rect>
    <path d="M121 92.5L188 93.5" fill="none" stroke="#efe6d2" stroke-width="2.2" stroke-linecap="round"></path>
    <path d="M95 109.5L99 99C100 97 102 96 104 96H152C156 96 158 98 159 100L163 109.5Z" fill="#efe6d2"></path>
    <path d="M95 109.5H163L161.2 104.5H96.8Z" fill="#efe6d2" opacity="0.7"></path>
    <g class="boat__portholes" fill="#ffe3a1">
      <circle cx="110" cy="101" r="2"></circle>
      <circle cx="122" cy="101" r="2"></circle>
      <circle cx="134" cy="101" r="2"></circle>
      <circle cx="146" cy="101" r="2"></circle>
    </g>
    <path d="M20 98C60 108 150 110 210 105L203 120C197 130 64 133 48 127C37 121 27 110 20 98Z" fill="#c9463d"></path>
    <path d="M30 110C70 120 180 121 206.5 113L203 120C197 130 64 133 48 127C40 122 34 116 30 110Z" fill="#0e1430" opacity="0.28"></path>
    <rect x="120.2" y="2" width="1.2" height="10" fill="#efe6d2"></rect>
    <path d="M121.4 2.6C125 3 130 4.6 136 5.6C130 6.6 125 8 121.4 8.6Z" fill="#c9463d"></path>
    <circle class="boat__light" cx="120.8" cy="12" r="3" fill="#ffe3a1"></circle>
  </g>
</svg>

<style>
  .boat {
    width: 4rem;
    aspect-ratio: 198 / 142;
    flex: none;
    overflow: visible;
  }
  /* o casco balança; o reflexo fica na água. Cada barco (--i do ancoradouro) tem o
     próprio ritmo e começa num ponto diferente da onda, para não balançarem juntos. */
  .boat__hull {
    transform-box: view-box;
    transform-origin: 115px 125px;
    animation: marola calc(3.4s + var(--i, 0) * 0.75s) var(--ease-in-out) calc(var(--i, 0) * -1.7s) infinite;
  }
  .boat__light {
    opacity: 0.6;
    filter: drop-shadow(0 0 4px var(--luz));
    animation: pulso 3s var(--ease-in-out) calc(var(--i, 0) * -0.8s) infinite;
    transition: opacity var(--dur-base);
  }
  .boat__portholes {
    opacity: 0.55;
    transition: opacity var(--dur-base);
  }
  .boat--lit .boat__light,
  .boat--lit .boat__portholes {
    opacity: 1;
  }
  .boat--lit .boat__light {
    filter: drop-shadow(0 0 7px var(--luz));
  }
  @media (--hover) {
    :global(.moored:hover) .boat__light,
    :global(.moored:focus-within) .boat__light,
    :global(.moored:hover) .boat__portholes,
    :global(.moored:focus-within) .boat__portholes {
      opacity: 1;
    }
  }
  @media (--reduced-motion) {
    .boat__hull,
    .boat__light {
      animation: none;
    }
  }
  /* sobe e desce com a onda, adernando para um lado e depois para o outro */
  @keyframes marola {
    25% {
      transform: translateY(2.5px) rotate(-3.5deg);
    }
    50% {
      transform: translateY(5px) rotate(0.5deg);
    }
    75% {
      transform: translateY(2px) rotate(3deg);
    }
  }
  @keyframes pulso {
    50% {
      opacity: 0.95;
    }
  }
</style>
