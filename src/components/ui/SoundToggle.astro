---
/**
 * Liga e desliga o som ambiente (scripts/sound.ts). Começa desligado;
 * todos os botões da página ficam em sincronia via aria-pressed.
 */
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<button
  class="sound"
  type="button"
  aria-pressed="false"
  aria-label={t.sound.on}
  data-sound-toggle
  data-label-on={t.sound.on}
  data-label-off={t.sound.off}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path class="sound__speaker" d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path>
    <path class="sound__muted" d="M15.5 9.5l5 5m0-5l-5 5"></path>
    <path class="sound__waves" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"></path>
  </svg>
</button>

<style>
  .sound {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    padding: 0;
    border: 1px solid color-mix(in oklch, var(--nevoa) 35%, transparent);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--farol-creme);
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      color var(--dur-fast),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .sound svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sound__speaker {
    fill: currentColor;
    stroke: none;
  }
  .sound__waves {
    display: none;
  }
  .sound[aria-pressed='true'] {
    border-color: var(--luz-media);
    color: var(--luz);
    box-shadow: 0 0 18px var(--luz-sutil);
  }
  .sound[aria-pressed='true'] .sound__muted {
    display: none;
  }
  .sound[aria-pressed='true'] .sound__waves {
    display: inline;
  }
  @media (--hover) {
    .sound:hover {
      border-color: var(--luz);
      color: var(--luz);
    }
  }
</style>
