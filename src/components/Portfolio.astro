---
/** A página inteira para um idioma. As rotas em pages/ só escolhem o locale. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layout/Footer.astro';
import Nav from '@/components/layout/Nav.astro';
import Scene from '@/components/scene/Scene.astro';
import Contact from '@/components/sections/Contact.astro';
import GitHub from '@/components/sections/GitHub.astro';
import Harbor from '@/components/sections/Harbor.astro';
import Hero from '@/components/sections/Hero.astro';
import Journey from '@/components/sections/Journey.astro';
import Projects from '@/components/sections/Projects.astro';
import Stack from '@/components/sections/Stack.astro';
import { profile } from '@/data/profile';
import type { Locale } from '@/i18n/ui';
import { getGitHubStats } from '@/lib/github';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const stats = await getGitHubStats(profile.github.user);
---

<BaseLayout locale={locale}>
  <Scene />
  <Nav locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Stack locale={locale} />
    <Projects locale={locale} repoCount={stats.publicRepos} />
    <GitHub locale={locale} stats={stats} />
    <Journey locale={locale} />
    <Contact locale={locale} />
  </main>
  <Harbor locale={locale} repoCount={stats.publicRepos} />
  <Footer />
</BaseLayout>

<script>
  import '@/scripts/main';
</script>
