---
import { profile } from '@/data/profile';
import { toMorse } from '@/lib/morse';
import { useTranslations, type Locale } from '@/i18n/ui';
import SectionHeader from '@/components/ui/SectionHeader.astro';

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const letters = toMorse(t.contact.morseWord);
const links = [
  { label: 'LinkedIn', text: profile.linkedin.label, url: profile.linkedin.url },
  { label: 'GitHub', text: `github.com/${profile.github.user}`, url: profile.github.url },
];
---

<section id="contact" class="section contact" data-section="contact" data-morse={t.contact.morseWord}>
  <SectionHeader section="contact" title={t.contact.title} description={t.contact.description} />

  <div class="contact__mail" data-reveal>
    <a class="contact__address" href={`mailto:${profile.email}`}>{profile.email}</a>
    <button class="btn btn--ghost" type="button" data-copy={profile.email} data-copied-label={t.contact.copied}>
      {t.contact.copy}
    </button>
  </div>

  <ul class="contact__links" data-reveal>
    {
      links.map((l) => (
        <li>
          <span class="mono-label">{l.label}</span>
          <a href={l.url} target="_blank" rel="noopener">
            {l.text} ↗
          </a>
        </li>
      ))
    }
  </ul>

  <p class="contact__morse" data-reveal>
    <span class="contact__signs" aria-hidden="true">
      {
        letters.map((letter) => (
          <span class="contact__letter">
            {[...letter].map((sign) => (
              <i class:list={['contact__sign', sign === '-' ? 'is-dash' : 'is-dot']} />
            ))}
          </span>
        ))
      }
    </span>
    <span class="mono-label">{t.contact.morseCaption}</span>
  </p>
</section>

<style>
  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
  }
  .contact__address {
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--luz);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact__links {
    display: grid;
    gap: var(--space-s);
    max-width: 32.5rem;
    margin: 0;
    padding: var(--space-m) 0 0;
    border-top: 1px solid var(--nevoa-linha);
    list-style: none;
  }
  .contact__links li {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    align-items: baseline;
    font: 400 0.75rem var(--font-mono);
  }
  .contact__links a {
    padding-block: var(--space-2xs);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact__morse {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
  }
  .contact__signs {
    display: inline-flex;
    gap: var(--space-s);
  }
  .contact__letter {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .contact__sign {
    height: 5px;
    border-radius: 3px;
    background: var(--luz);
    opacity: 0.25;
    transition: opacity var(--dur-instant);
  }
  .contact__sign.is-dash {
    width: 1.125rem;
  }
  .contact__sign.is-dot {
    width: 5px;
  }
  .contact__sign.is-on {
    opacity: 1;
    box-shadow: 0 0 8px var(--luz);
  }
  @media (--tablet) {
    .contact__links li {
      grid-template-columns: 5.625rem 1fr;
      font-size: var(--text-mono);
    }
  }
  @media (--hover) {
    .contact__address:hover {
      text-decoration: underline;
      text-underline-offset: 6px;
    }
    .contact__links a:hover {
      color: var(--luz);
    }
  }
</style>
