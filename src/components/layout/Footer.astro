---
import { profile } from '@/data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <p>© {year} {profile.name.first} {profile.name.last}</p>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    padding: var(--space-l) max(var(--space-l), env(safe-area-inset-left)) max(var(--space-l), env(safe-area-inset-bottom));
    font: 400 var(--text-label) var(--font-mono);
    color: var(--nevoa);
    position: relative;
    z-index: var(--z-chrome);
  }
  .footer p {
    margin: 0;
  }
  /* No stage o rodapé fica fixo no pé da tela. */
  @media (--stage) {
    .footer {
      position: fixed;
      inset: auto 0 0;
      padding: var(--space-xl) 4rem var(--space-l);
      pointer-events: none;
      /* seções altas rolam por baixo: o degradê mantém o texto legível */
      background: linear-gradient(to top, color-mix(in oklch, var(--noite-funda) 92%, transparent) 40%, transparent);
    }
  }
</style>
